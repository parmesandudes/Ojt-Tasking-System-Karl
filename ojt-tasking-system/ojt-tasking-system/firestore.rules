rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signed() { return request.auth != null; }
    function isAdmin() { return signed() && exists(/databases/$(db)/documents/admins/$(request.auth.uid)); }
    function owns(internId) { return signed() && get(/databases/$(db)/documents/interns/$(internId)).data.claimedBy == request.auth.uid; }

    match /admins/{uid}  { allow read: if signed() && request.auth.uid == uid; }
    match /fields/{id}   { allow read: if signed(); allow write: if isAdmin(); }
    match /tasks/{id}    { allow read: if signed(); allow write: if isAdmin(); }

    // Interns can only claim a FREE profile, or give back their own.
    match /interns/{id} {
      allow read: if signed();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (signed() && resource.data.get('claimedBy', '') == ''
            && request.resource.data.claimedBy == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedBy']))
        || (signed() && resource.data.get('claimedBy', '') == request.auth.uid
            && request.resource.data.claimedBy == ''
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedBy']));
    }

    // One doc per task+intern. An intern can only write their OWN progress.
    match /progress/{pid} {
      allow read: if signed();
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
        || (request.resource.data.status in ['pending', 'done', 'unfinished']
            && pid == request.resource.data.taskId + '_' + request.resource.data.internId
            && owns(request.resource.data.internId));
    }
  }
}
