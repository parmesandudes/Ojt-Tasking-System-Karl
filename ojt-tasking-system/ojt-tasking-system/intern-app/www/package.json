{
  "name": "ojt-intern-app",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@capacitor/core": "^6.0.0",
    "@capacitor/android": "^6.0.0",
    "@capacitor/ios": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0"
  },
  "scripts": {
    "build": "node -e \"const fs=require('fs');fs.mkdirSync('www',{recursive:true});['index.html','firebase-config.js'].forEach(f=>fs.copyFileSync(f,'www/'+f))\"",
    "sync": "npm run build && cap sync"
  }
}